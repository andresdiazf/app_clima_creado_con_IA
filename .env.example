# ============================================================
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO
# ============================================================
# 
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo a ".env"
# 2. Rellena los valores reales (nunca subas .env a GitHub)
# 3. El archivo .env ya está en .gitignore (protegido)
#
# ¿Por qué usamos variables de entorno?
# - Separan la configuración del código
# - Evitan exponer claves secretas en GitHub
# - Permiten tener diferentes valores en desarrollo y producción
# ============================================================


# ── APIs de Clima ────────────────────────────────────────────
# Open-Meteo no requiere API key (es gratuita y abierta)
# Pero si en el futuro usas otra API, la pondrías aquí:

# WEATHER_API_KEY=tu_clave_secreta_aqui
# WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# GEOCODING_API_KEY=tu_clave_secreta_aqui
# GEOCODING_API_URL=https://geocoding-api.open-meteo.com/v1/search


# ── Configuración de la App ──────────────────────────────────
# APP_NAME=Weather App
# APP_VERSION=1.0.0
# MAX_RECENT_CITIES=5
# FORECAST_DAYS=7


# ── Ejemplo con OpenWeatherMap (API de pago) ─────────────────
# Si migras a OpenWeatherMap, usarías:
# OWM_API_KEY=abc123def456ghi789
# OWM_BASE_URL=https://api.openweathermap.org/data/2.5
